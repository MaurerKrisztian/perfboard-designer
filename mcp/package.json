{
  "name": "perfboard-designer-mcp",
  "version": "0.1.1",
  "description": "MCP server for Perfboard Designer: lets AI agents look up parts, check perfboard and stripboard layouts, and hand back a link that opens the board in the editor.",
  "license": "ISC",
  "mcpName": "com.perfboarddesigner/mcp",
  "homepage": "https://perfboarddesigner.com/mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaurerKrisztian/perfboard-designer.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/MaurerKrisztian/perfboard-designer/issues",
  "type": "module",
  "bin": {
    "perfboard-designer-mcp": "dist/server.js"
  },
  "files": [
    "dist/server.js",
    "dist/resvg.wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js",
    "worker:dev": "wrangler dev --var PERFBOARD_PROJECTS_URL:http://localhost:8787",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1",
    "zod": "^4.6.7"
  }
}
