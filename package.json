    "@typescript-eslint/parser": "5.33.0",
    "@vitejs/plugin-react": "2.2.0",
    "autoprefixer": "10.4.8",
    "eslint": "8.21.0",
    "eslint-import-resolver-typescript": "3.4.1",
    "eslint-plugin-import": "2.26.0",
